NODE_ENV=development
PORT=4000
# Local PostgreSQL example. For Supabase, use the private pooled PostgreSQL URL.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5432/hireflow
DATABASE_SSL=disable
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_SAME_SITE=lax
RESEND_API_KEY=
# Keep blank until a verified sender is configured.
EMAIL_FROM=
APP_BASE_URL=http://localhost:5173
CANDIDATE_RETENTION_DAYS=
CAMPAIGN_QUEUE_LIMIT_PER_HOUR=1000
WORKSPACE_QUEUE_LIMIT_PER_HOUR=10000
VITE_API_BASE_URL=/api
VITE_REQUIRE_AUTH=false
# Use only for the disposable integration suite; the database name must include test, integration, or ci.
INTEGRATION_DATABASE_URL=postgresql://localhost:5432/hireflow_test
